<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Jellyfin.Plugin.SubtitleCat.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      Referenced here WITHOUT ExcludeAssets, unlike the plugin project. The plugin
      excludes the runtime assets because Jellyfin supplies them at run time, but the
      test host has no Jellyfin around it, so the real assemblies have to be present or
      every test that touches a type from them fails to load.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.SubtitleCat\Jellyfin.Plugin.SubtitleCat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Saved from the live site. See Fixtures/README.md for what each one is. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
